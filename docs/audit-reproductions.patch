+package main
+
+import (
+	"context"
+	"prui/internal/session"
+	"prui/internal/source"
+	"prui/internal/tui"
+	"runtime"
+	"testing"
+)
+
+func TestAuditDescriptionEditAllowsComment(t *testing.T) {
+	app, saved := wiringFixture(t)
+	frozen := saved.Inventory.Comparison.Metadata
+	app.gh.(*fixtureGH).value.Description = "edited description"
+	_, err := app.submitReviewComment(context.Background(), tui.CommentSubmission{Metadata: frozen, Comment: source.ReviewComment{Body: "hello", Target: source.ReviewCommentTarget{Identity: frozen.Identity, CommitID: frozen.HeadSHA, Path: "a", Side: "RIGHT", Line: 1}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+func TestAuditBackgroundRefreshRace(t *testing.T) {
+	app, saved := wiringFixture(t)
+	saved.RevisionStatus = session.Unchecked
+	done := make(chan error, 1)
+	go func() { _, err := app.refreshOpenedPullRequest(context.Background(), saved, nil); done <- err }()
+	for {
+		select {
+		case err := <-done:
+			if err != nil {
+				t.Fatal(err)
+			}
+			return
+		default:
+			if saved.RevisionStatus == session.Current {
+				runtime.Gosched()
+			}
+			runtime.Gosched()
+		}
+	}
+}
