+package source
+
+import (
+	"context"
+	"strings"
+	"testing"
+)
+
+func TestAuditFileCommentDoesNotHideLineComments(t *testing.T) {
+	sha := strings.Repeat("a", 40)
+	payload := `[{"id":1,"body":"file comment","commit_id":"` + sha + `","path":"a.go","subject_type":"file","line":null,"side":"RIGHT","user":{"login":"alice"}},{"id":2,"body":"line comment","commit_id":"` + sha + `","path":"a.go","line":1,"side":"RIGHT","user":{"login":"alice"}}]`
+	g := GH{Limits: Defaults(), Runner: listRunner(func(context.Context, Request) ([]byte, error) { return []byte(payload), nil })}
+	comments, err := g.ListReviewComments(context.Background(), Identity{Repository: "owner/repo", Number: 1})
+	if err != nil || len(comments) != 1 {
+		t.Fatalf("supported line comment lost: comments=%d err=%v", len(comments), err)
+	}
+}
