+func TestAuditJSONCredential(t *testing.T) {
+	b := &builder{}
+	id := b.unit("config.json", "@@ -0,0 +1 @@\n+{\"api_key\": \"synthetic-value\"}\n", inventory.TextHunk)
+	in := InputFrom(b.build(), reviewcontext.ContextBundle{}, privacy.Policy{}, Defaults)
+	if sent(in, id) {
+		t.Fatal("JSON api_key reached upload input")
+	}
+}
